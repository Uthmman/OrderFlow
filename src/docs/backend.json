{
  "entities": {
    "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "Represents a customer profile within the OrderFlow application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Customer entity."
        },
        "name": {
          "type": "string",
          "description": "The full name of the customer."
        },
        "email": {
          "type": "string",
          "description": "The email address of the customer.",
          "format": "email"
        },
        "phoneNumbers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "number": { "type": "string" }
            }
          }
        },
        "location": {
          "type": "object",
          "properties": {
            "town": { "type": "string" },
            "mapUrl": { "type": "string" }
          }
        },
        "orderIds": {
          "type": "array",
          "description": "References to Orders placed by this customer.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Order": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Order",
      "type": "object",
      "description": "Represents an order placed by a customer.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Order entity."
        },
        "customerId": {
          "type": "string",
          "description": "Reference to Customer."
        },
        "uniqueName": {
          "type": "string",
          "description": "A descriptive name for the order (e.g., 'John - Sofa - X123')."
        },
        "status": {
          "type": "string",
          "description": "The current status of the order."
        },
        "incomeAmount": {
          "type": "number",
          "description": "The price of the order."
        },
        "deadline": {
          "type": "string",
          "description": "The deadline for the order completion.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "customerId",
        "status",
        "deadline"
      ]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a product in the catalog.",
      "properties": {
        "id": { "type": "string" },
        "productName": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "orderIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "productName", "category"]
    },
    "SecondaryItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SecondaryItem",
      "type": "object",
      "description": "Represents a material or item in the secondary catalog project.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "AppUser": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AppUser",
      "type": "object",
      "description": "Represents a user profile in the system.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/customers/{customerId}",
        "definition": {
          "entityName": "Customer",
          "description": "Stores customer profiles."
        }
      },
      {
        "path": "/orders/{orderId}",
        "definition": {
          "entityName": "Order",
          "description": "Stores order information."
        }
      },
      {
        "path": "/products/{productId}",
        "definition": {
          "entityName": "Product",
          "description": "Stores product catalog information."
        }
      },
      {
        "path": "/items/{itemId}",
        "definition": {
          "entityName": "SecondaryItem",
          "description": "Stores material items in the catalog project."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "AppUser",
          "description": "Stores user profiles."
        }
      }
    ],
    "reasoning": "The Firestore structure is designed for a secure, multi-role furniture manufacturing workflow. It organizes data into top-level collections for customers, orders, products, and catalog items. Access control is based on user roles (Admin, Designer, Sales, Manager) and authenticated status."
  }
}
