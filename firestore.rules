
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get the current user's role
    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null ? userDoc.data.role : 'Pending';
    }

    // Allow all authenticated users to read items from the catalog
    match /items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getUserRole() == 'Admin';
    }

    // Customer rules
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (getUserRole() == 'Admin' || getUserRole() == 'Sales');
    }

    // Order rules
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Product rules
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // User Profile rules
    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || getUserRole() == 'Admin');
      
      match /notifications/{notificationId} {
        allow read, update, delete: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated();
      }
    }

    // Settings rules - Branding and Colors must be readable by all logged in users
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getUserRole() == 'Admin';
    }

    // Stock rules
    match /stock/{stockId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /stockTransactions/{txId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Catch-all for other collections during development
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
