
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get the current user's role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Allow all authenticated users to read items from the catalog
    match /items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getUserRole() == 'Admin';
    }

    // Customer rules
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (getUserRole() == 'Admin' || getUserRole() == 'Sales');
    }

    // Order rules
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Product rules
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // User Profile rules
    match /users/{userId} {
      // Any authenticated user can view user profiles (required for chat and assignment displays)
      allow get: if isAuthenticated();
      // Allow any team member to list users to see who is assigned to orders
      allow list: if isAuthenticated();
      // Users can only write to their own profile, unless they are an Admin
      allow write: if isAuthenticated() && (request.auth.uid == userId || getUserRole() == 'Admin');
      
      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Settings rules
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getUserRole() == 'Admin';
    }

    // Stock rules
    match /stock/{stockId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /stockTransactions/{txId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Catch-all for other collections during development
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
